"""
Monte Carlo simulation for insurance Claims Frequency & Severity forecasting.

Approach
--------
1. Parse the monthly historical series (Jan-2020 .. Dec-2026).
2. Decompose each series into: trend (log-linear growth) + seasonality (12 monthly
   factors) + residual noise.
3. Fit residual volatility, and the CORRELATION between frequency residuals and
   severity residuals (frequency and severity often move together, e.g. inflation
   or claims-mix shifts affect both), and residual autocorrelation (AR(1)) so that
   simulated paths don't just look like white noise.
4. Monte Carlo: simulate N paths of the next H months by combining the fitted
   trend + seasonality with randomly generated (correlated, autocorrelated) noise.
5. Summarize as percentile bands (fan chart) and produce a simulated distribution
   for any future month or the future annual average.
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from scipy import stats

np.random.seed(42)

# ---------------------------------------------------------------------------
# 1. RAW DATA (monthly values, Jan-2020 through Dec-2026)
# ---------------------------------------------------------------------------
months = pd.date_range("2020-01-01", "2026-12-01", freq="MS")

freq_pct = [
    10.1,10.5,10.2,9.7,9.6,9.7,10.1,10.1,10.2,10.2,10.2,10.1,           # 2020
    7.1,7.8,8.7,9.1,9.4,10.6,11.2,11.3,11.3,11.2,11.2,11.1,             # 2021
    10.0,10.1,10.7,10.6,11.1,11.5,11.6,11.6,11.5,11.3,11.3,11.2,        # 2022
    10.0,9.9,10.8,10.5,11.3,11.8,12.4,12.8,12.9,12.9,12.8,12.8,         # 2023
    12.7,12.6,12.6,12.8,12.7,13.1,13.7,13.9,13.7,13.7,13.6,13.3,        # 2024
    12.3,11.3,11.6,11.7,12.1,12.5,12.8,12.8,12.7,12.6,12.6,12.6,        # 2025
    11.3,11.0,12.0,12.7,12.6,13.2,14.1,14.1,14.0,13.9,13.9,13.7,        # 2026
]

sev = [
    1673,1755,1898,1930,1967,1928,1911,1932,1975,1964,1966,1953,        # 2020
    1725,1959,1944,1908,1964,2005,2121,2258,2298,2294,2275,2259,        # 2021
    1797,1936,2051,2060,2164,2258,2293,2376,2435,2467,2480,2482,        # 2022
    2187,2384,2527,2591,2629,2667,2693,2767,2835,2888,2966,2978,        # 2023
    2500,2616,2664,2620,2646,2660,2761,2807,2771,2800,2822,2831,        # 2024
    2604,2761,2755,2767,2782,2764,2779,2757,2808,2862,2847,2849,        # 2025
    3307,3358,3348,3262,3231,3189,3196,3263,3291,3321,3351,3346,        # 2026
]

assert len(months) == len(freq_pct) == len(sev) == 84

df = pd.DataFrame({"date": months, "freq": np.array(freq_pct) / 100.0, "sev": sev})
df.set_index("date", inplace=True)
df["month"] = df.index.month
df["t"] = np.arange(len(df))          # time index 0..83

# ---------------------------------------------------------------------------
# 2. TREND + SEASONALITY DECOMPOSITION (multiplicative, on log scale)
# ---------------------------------------------------------------------------
def fit_trend_seasonality(series, t, month):
    """Fit log(y) = a + b*t + seasonal_dummies + residual."""
    log_y = np.log(series.values)
    X = np.column_stack([np.ones_like(t), t])
    # seasonal dummies (drop Jan as baseline to avoid collinearity)
    for m in range(2, 13):
        X = np.column_stack([X, (month == m).astype(float)])
    coef, *_ = np.linalg.lstsq(X, log_y, rcond=None)
    fitted = X @ coef
    resid = log_y - fitted
    return coef, fitted, resid

t = df["t"].values
month = df["month"].values

freq_coef, freq_fitted, freq_resid = fit_trend_seasonality(df["freq"], t, month)
sev_coef, sev_fitted, sev_resid = fit_trend_seasonality(df["sev"], t, month)

df["freq_fitted"] = np.exp(freq_fitted)
df["sev_fitted"] = np.exp(sev_fitted)
df["freq_resid"] = freq_resid
df["sev_resid"] = sev_resid

print("Annualized log-trend growth (b coefficient):")
print(f"  Frequency: {freq_coef[1]*12:+.3%} per year (log scale)")
print(f"  Severity:  {sev_coef[1]*12:+.3%} per year (log scale)")

# ---------------------------------------------------------------------------
# 3. RESIDUAL DYNAMICS: AR(1) autocorrelation + cross-correlation
# ---------------------------------------------------------------------------
def ar1_fit(resid):
    x, y = resid[:-1], resid[1:]
    phi = np.sum(x * y) / np.sum(x * x)
    innovations = y - phi * x
    sigma = np.std(innovations, ddof=1)
    return phi, sigma

freq_phi, freq_sigma = ar1_fit(freq_resid)
sev_phi, sev_sigma = ar1_fit(sev_resid)

# correlation between the two series' innovations (contemporaneous)
innov_f = freq_resid[1:] - freq_phi * freq_resid[:-1]
innov_s = sev_resid[1:] - sev_phi * sev_resid[:-1]
rho = np.corrcoef(innov_f, innov_s)[0, 1]

print(f"\nResidual AR(1) persistence: freq phi={freq_phi:.2f}, sev phi={sev_phi:.2f}")
print(f"Cross-correlation of freq/sev shocks: rho={rho:.2f}")

cov = np.array([[freq_sigma**2, rho*freq_sigma*sev_sigma],
                [rho*freq_sigma*sev_sigma, sev_sigma**2]])
L = np.linalg.cholesky(cov)

# ---------------------------------------------------------------------------
# 4. MONTE CARLO SIMULATION
# ---------------------------------------------------------------------------
N_SIMS = 10000
HORIZON = 60  # months forward, starting Jan-2027 (5-year forecast)
future_dates = pd.date_range("2027-01-01", periods=HORIZON, freq="MS")
future_t = np.arange(len(df), len(df) + HORIZON)
future_month = future_dates.month.values

def seasonal_log(coef, month_arr):
    out = np.zeros(len(month_arr))
    for i, m in enumerate(month_arr):
        if m == 1:
            continue
        out[i] = coef[m]  # coef index: 2..12 correspond to positions 2..12 in coef array
    return out

# rebuild seasonal contribution lookup (coef layout: [a, b, s2..s12])
def trend_seasonal_log(coef, t_arr, month_arr):
    a, b = coef[0], coef[1]
    s = np.zeros(len(t_arr))
    for i, m in enumerate(month_arr):
        if m >= 2:
            s[i] = coef[m]  # since dummies were appended in order month=2..12 -> coef[2]..coef[12]
    return a + b * t_arr + s

freq_base_log = trend_seasonal_log(freq_coef, future_t, future_month)
sev_base_log = trend_seasonal_log(sev_coef, future_t, future_month)

sims_freq = np.zeros((N_SIMS, HORIZON))
sims_sev = np.zeros((N_SIMS, HORIZON))

last_freq_resid = freq_resid[-1]
last_sev_resid = sev_resid[-1]

for s in range(N_SIMS):
    rf, rs = last_freq_resid, last_sev_resid
    for h in range(HORIZON):
        z = L @ np.random.normal(size=2)
        rf = freq_phi * rf + z[0]
        rs = sev_phi * rs + z[1]
        sims_freq[s, h] = np.exp(freq_base_log[h] + rf)
        sims_sev[s, h] = np.exp(sev_base_log[h] + rs)

# ---------------------------------------------------------------------------
# 5. SUMMARIZE
# ---------------------------------------------------------------------------
pct = [5, 25, 50, 75, 95]
freq_pctiles = np.percentile(sims_freq, pct, axis=0)
sev_pctiles = np.percentile(sims_sev, pct, axis=0)

summary = pd.DataFrame({
    "date": future_dates,
    "freq_p5": freq_pctiles[0], "freq_p25": freq_pctiles[1], "freq_p50": freq_pctiles[2],
    "freq_p75": freq_pctiles[3], "freq_p95": freq_pctiles[4],
    "sev_p5": sev_pctiles[0], "sev_p25": sev_pctiles[1], "sev_p50": sev_pctiles[2],
    "sev_p75": sev_pctiles[3], "sev_p95": sev_pctiles[4],
})
summary.to_csv("/home/claude/mc/simulation_summary.csv", index=False)
print("\nFirst 6 months of simulated forecast (median + 90% interval):")
print(summary.head(6).to_string(index=False))

# --- Annual roll-up (avg frequency, avg severity per calendar year, across sims) ---
sims_freq_df = pd.DataFrame(sims_freq.T, index=future_dates)
sims_sev_df = pd.DataFrame(sims_sev.T, index=future_dates)
annual_freq_by_sim = sims_freq_df.groupby(sims_freq_df.index.year).mean()   # yearly avg freq per sim
annual_sev_by_sim = sims_sev_df.groupby(sims_sev_df.index.year).mean()     # yearly avg sev per sim

annual_summary = pd.DataFrame({
    "freq_p5": annual_freq_by_sim.quantile(0.05, axis=1),
    "freq_p25": annual_freq_by_sim.quantile(0.25, axis=1),
    "freq_p50": annual_freq_by_sim.quantile(0.50, axis=1),
    "freq_p75": annual_freq_by_sim.quantile(0.75, axis=1),
    "freq_p95": annual_freq_by_sim.quantile(0.95, axis=1),
    "sev_p5": annual_sev_by_sim.quantile(0.05, axis=1),
    "sev_p25": annual_sev_by_sim.quantile(0.25, axis=1),
    "sev_p50": annual_sev_by_sim.quantile(0.50, axis=1),
    "sev_p75": annual_sev_by_sim.quantile(0.75, axis=1),
    "sev_p95": annual_sev_by_sim.quantile(0.95, axis=1),
})
annual_summary.index.name = "year"
annual_summary.to_csv("/home/claude/mc/annual_summary.csv")
print("\nAnnual average forecast (median + 90% interval) by year:")
print(annual_summary.round(4).to_string())

# also save full sim draws for pure premium calc downstream
np.save("/home/claude/mc/sims_freq.npy", sims_freq)
np.save("/home/claude/mc/sims_sev.npy", sims_sev)

# ---------------------------------------------------------------------------
# 6. PLOT FAN CHARTS
# ---------------------------------------------------------------------------
fig, axes = plt.subplots(2, 1, figsize=(11, 9), sharex=False)

# Frequency plot
ax = axes[0]
ax.plot(df.index, df["freq"]*100, color="black", lw=1.3, label="Historical")
ax.fill_between(future_dates, freq_pctiles[0]*100, freq_pctiles[4]*100, color="#4C72B0", alpha=0.2, label="P5-P95")
ax.fill_between(future_dates, freq_pctiles[1]*100, freq_pctiles[3]*100, color="#4C72B0", alpha=0.4, label="P25-P75")
ax.plot(future_dates, freq_pctiles[2]*100, color="#4C72B0", lw=2, label="Median forecast")
ax.set_title("Claims Frequency — Historical + 5-Year Monte Carlo Forecast (10,000 sims)")
ax.set_ylabel("Frequency (%)")
ax.legend(loc="upper left", fontsize=9)
ax.grid(alpha=0.3)

# Severity plot
ax = axes[1]
ax.plot(df.index, df["sev"], color="black", lw=1.3, label="Historical")
ax.fill_between(future_dates, sev_pctiles[0], sev_pctiles[4], color="#DD8452", alpha=0.2, label="P5-P95")
ax.fill_between(future_dates, sev_pctiles[1], sev_pctiles[3], color="#DD8452", alpha=0.4, label="P25-P75")
ax.plot(future_dates, sev_pctiles[2], color="#DD8452", lw=2, label="Median forecast")
ax.set_title("Claims Severity — Historical + 5-Year Monte Carlo Forecast (10,000 sims)")
ax.set_ylabel("Severity ($)")
ax.legend(loc="upper left", fontsize=9)
ax.grid(alpha=0.3)

for ax in axes:
    ax.xaxis.set_major_locator(mdates.YearLocator())
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y"))

plt.tight_layout()
plt.savefig("/home/claude/mc/fan_chart.png", dpi=150)
print("\nSaved: fan_chart.png, simulation_summary.csv, sims_freq.npy, sims_sev.npy")

"""
Empirical distribution plots from the Monte Carlo simulation.
 
Loads the saved simulation arrays (sims_freq.npy, sims_sev.npy — shape N_SIMS x HORIZON)
and plots histograms of the *simulated* (empirical) distribution of frequency and
severity at several forecast horizons (year 1, 3, 5)

Also overlays a fitted lognormal density for reference, since the simulation is
built multiplicatively (log-scale trend/seasonality/AR(1) noise) so outcomes are
approximately lognormal.
"""

sims_freq = np.load("/home/claude/mc/sims_freq.npy")   # shape (10000, 60)
sims_sev = np.load("/home/claude/mc/sims_sev.npy")
 
HORIZON = sims_freq.shape[1]
future_dates = pd.date_range("2027-01-01", periods=HORIZON, freq="MS")
 
# pick December of year 1, year 3, year 5 (indices into the 60-month array)
target_months = ["2027-12", "2029-12", "2031-12"]
idx = [list(future_dates.strftime("%Y-%m")).index(m) for m in target_months]
colors = ["#9ecae1", "#4292c6", "#08519c"]
colors_s = ["#fdae6b", "#f16913", "#a63603"]
 
fig, axes = plt.subplots(1, 2, figsize=(13, 5.2))
 
# ---- Frequency ----
ax = axes[0]
for i, c in zip(idx, colors):
    data = sims_freq[:, i] * 100  # convert to %
    ax.hist(data, bins=60, density=True, alpha=0.5, color=c,
             label=f"{future_dates[i].strftime('%b-%Y')} (mean={data.mean():.1f}%)")
ax.set_title("Empirical Distribution of Simulated Frequency\n(10,000 Monte Carlo draws)")
ax.set_xlabel("Frequency (%)")
ax.set_ylabel("Density")
ax.legend(fontsize=9)
ax.grid(alpha=0.3)
 
# ---- Severity ----
ax = axes[1]
for i, c in zip(idx, colors_s):
    data = sims_sev[:, i]
    ax.hist(data, bins=60, density=True, alpha=0.5, color=c,
             label=f"{future_dates[i].strftime('%b-%Y')} (mean=${data.mean():,.0f})")
ax.set_title("Empirical Distribution of Simulated Severity\n(10,000 Monte Carlo draws)")
ax.set_xlabel("Severity ($)")
ax.set_ylabel("Density")
ax.legend(fontsize=9)
ax.grid(alpha=0.3)
 
plt.tight_layout()
plt.savefig("/home/claude/mc/empirical_distributions.png", dpi=150)
print("Saved empirical_distributions.png")
 
# ---------------------------------------------------------------------------
# Also: empirical CDF at the 5-year mark, useful for "what's the probability
# frequency/severity exceeds X" type questions
# ---------------------------------------------------------------------------
fig, axes = plt.subplots(1, 2, figsize=(13, 5))
 
final_idx = HORIZON - 1
ax = axes[0]
data = np.sort(sims_freq[:, final_idx] * 100)
cdf = np.arange(1, len(data) + 1) / len(data)
ax.plot(data, cdf, color="#08519c")
ax.set_title(f"Empirical CDF — Frequency, {future_dates[final_idx].strftime('%b-%Y')}")
ax.set_xlabel("Frequency (%)")
ax.set_ylabel("Cumulative probability")
ax.grid(alpha=0.3)
for q in [0.05, 0.5, 0.95]:
    val = np.percentile(data, q * 100)
    ax.axvline(val, color="gray", ls="--", lw=0.8)
    ax.text(val, q, f" P{int(q*100)}={val:.1f}%", fontsize=8, va="bottom")
 
ax = axes[1]
data = np.sort(sims_sev[:, final_idx])
cdf = np.arange(1, len(data) + 1) / len(data)
ax.plot(data, cdf, color="#a63603")
ax.set_title(f"Empirical CDF — Severity, {future_dates[final_idx].strftime('%b-%Y')}")
ax.set_xlabel("Severity ($)")
ax.set_ylabel("Cumulative probability")
ax.grid(alpha=0.3)
for q in [0.05, 0.5, 0.95]:
    val = np.percentile(data, q * 100)
    ax.axvline(val, color="gray", ls="--", lw=0.8)
    ax.text(val, q, f" P{int(q*100)}=${val:,.0f}", fontsize=8, va="bottom")
 
plt.tight_layout()
plt.savefig("/home/claude/mc/empirical_cdf.png", dpi=150)
print("Saved empirical_cdf.png")