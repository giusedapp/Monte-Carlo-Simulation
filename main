"""
Monte Carlo simulation for insurance Claims Frequency & Severity forecasting,
extended with:
  (a) a sieve bootstrap over the trend/seasonal/AR(1) parameters, so forecast
      uncertainty reflects BOTH residual noise AND the fact that the fitted
      coefficients themselves are estimated from only 84 monthly observations
  (b) Q-Q plots (+ Shapiro-Wilk tests) checking whether the log-residuals that
      drive the whole simulation are actually approximately Gaussian, which is
      the assumption that makes the simulated levels approximately lognormal.

Approach
--------
1. Parse the monthly historical series (Jan-2020 .. Dec-2026).
2. Decompose each series into: trend (log-linear growth) + seasonality (12 monthly
   factors) + residual noise.
3. Fit residual volatility, the CORRELATION between frequency and severity
   residuals, and residual autocorrelation (AR(1)).
3b. Sieve bootstrap: resample the AR(1) innovations with replacement, rebuild
    pseudo history, re-fit trend/seasonal + AR(1) + correlation on each
    resample -> a distribution of plausible parameter sets.
3c. Q-Q plots of the fitted residuals against a Normal distribution, to check
    the Gaussian-innovation assumption.
4. Monte Carlo: for each simulated path, draw ONE bootstrap parameter set and
   simulate the next H months using THAT path's own trend/seasonal/AR/cov,
   combined with fresh correlated, autocorrelated random shocks. This nests
   parameter uncertainty inside the Monte Carlo (a standard "bootstrap the
   parameters, then simulate" hierarchy).
5. Summarize as percentile bands (fan chart), compare band width against the
   original fixed-parameter approach, and produce simulated distributions.
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from scipy import stats

np.random.seed(42)
rng = np.random.default_rng(42)

OUT = "/home/claude/mc"

# ---------------------------------------------------------------------------
# 1. RAW DATA (monthly values, Jan-2020 through Dec-2026)
# ---------------------------------------------------------------------------
months = pd.date_range("2020-01-01", "2026-12-01", freq="MS")

freq_pct = [
    10.1,10.5,10.2,9.7,9.6,9.7,10.1,10.1,10.2,10.2,10.2,10.1,           # 2020
    7.1,7.8,8.7,9.1,9.4,10.6,11.2,11.3,11.3,11.2,11.2,11.1,             # 2021
    10.0,10.1,10.7,10.6,11.1,11.5,11.6,11.6,11.5,11.3,11.3,11.2,        # 2022
    10.0,9.9,10.8,10.5,11.3,11.8,12.4,12.8,12.9,12.9,12.8,12.8,         # 2023
    12.7,12.6,12.6,12.8,12.7,13.1,13.7,13.9,13.7,13.7,13.6,13.3,        # 2024
    12.3,11.3,11.6,11.7,12.1,12.5,12.8,12.8,12.7,12.6,12.6,12.6,        # 2025
    11.3,11.0,12.0,12.7,12.6,13.2,14.1,14.1,14.0,13.9,13.9,13.7,        # 2026
]

sev = [
    1673,1755,1898,1930,1967,1928,1911,1932,1975,1964,1966,1953,        # 2020
    1725,1959,1944,1908,1964,2005,2121,2258,2298,2294,2275,2259,        # 2021
    1797,1936,2051,2060,2164,2258,2293,2376,2435,2467,2480,2482,        # 2022
    2187,2384,2527,2591,2629,2667,2693,2767,2835,2888,2966,2978,        # 2023
    2500,2616,2664,2620,2646,2660,2761,2807,2771,2800,2822,2831,        # 2024
    2604,2761,2755,2767,2782,2764,2779,2757,2808,2862,2847,2849,        # 2025
    3307,3358,3348,3262,3231,3189,3196,3263,3291,3321,3351,3346,        # 2026
]

assert len(months) == len(freq_pct) == len(sev) == 84

df = pd.DataFrame({"date": months, "freq": np.array(freq_pct) / 100.0, "sev": sev})
df.set_index("date", inplace=True)
df["month"] = df.index.month
df["t"] = np.arange(len(df))          # time index 0..83

# ---------------------------------------------------------------------------
# 2. TREND + SEASONALITY DECOMPOSITION (multiplicative, on log scale)
# ---------------------------------------------------------------------------
def build_design(t, month):
    X = np.column_stack([np.ones_like(t, dtype=float), t.astype(float)])
    for m in range(2, 13):
        X = np.column_stack([X, (month == m).astype(float)])
    return X

def fit_trend_seasonality(log_y, X):
    coef, *_ = np.linalg.lstsq(X, log_y, rcond=None)
    fitted = X @ coef
    resid = log_y - fitted
    return coef, fitted, resid

t = df["t"].values
month = df["month"].values
X_design = build_design(t, month)

freq_coef, freq_fitted, freq_resid = fit_trend_seasonality(np.log(df["freq"].values), X_design)
sev_coef, sev_fitted, sev_resid = fit_trend_seasonality(np.log(df["sev"].values), X_design)

df["freq_fitted"] = np.exp(freq_fitted)
df["sev_fitted"] = np.exp(sev_fitted)
df["freq_resid"] = freq_resid
df["sev_resid"] = sev_resid

print("Annualized log-trend growth (b coefficient):")
print(f"  Frequency: {freq_coef[1]*12:+.3%} per year (log scale)")
print(f"  Severity:  {sev_coef[1]*12:+.3%} per year (log scale)")

# ---------------------------------------------------------------------------
# 3. RESIDUAL DYNAMICS: AR(1) autocorrelation + cross-correlation
# ---------------------------------------------------------------------------
def ar1_fit(resid):
    x, y = resid[:-1], resid[1:]
    phi = np.sum(x * y) / np.sum(x * x)
    innovations = y - phi * x
    sigma = np.std(innovations, ddof=1)
    return phi, sigma, innovations

freq_phi, freq_sigma, innov_f = ar1_fit(freq_resid)
sev_phi, sev_sigma, innov_s = ar1_fit(sev_resid)

rho = np.corrcoef(innov_f, innov_s)[0, 1]

print(f"\nResidual AR(1) persistence: freq phi={freq_phi:.2f}, sev phi={sev_phi:.2f}")
print(f"Cross-correlation of freq/sev shocks: rho={rho:.2f}")

cov = np.array([[freq_sigma**2, rho*freq_sigma*sev_sigma],
                [rho*freq_sigma*sev_sigma, sev_sigma**2]])
L = np.linalg.cholesky(cov)

# ---------------------------------------------------------------------------
# 3b. Q-Q PLOTS: is the Gaussian-innovation assumption reasonable?
# ---------------------------------------------------------------------------
# We check the AR(1) INNOVATIONS (the part actually assumed i.i.d. Normal),
# not the raw residuals (which are autocorrelated by construction and would
# fail a normality check for a different reason).
fig, axes = plt.subplots(1, 2, figsize=(11, 5))

(osm_f, osr_f), (slope_f, intercept_f, r_f) = stats.probplot(innov_f, dist="norm")
axes[0].scatter(osm_f, osr_f, s=18, color="#4C72B0", alpha=0.8)
axes[0].plot(osm_f, slope_f*osm_f + intercept_f, color="black", lw=1, ls="--")
axes[0].set_title(f"Q-Q Plot — Frequency AR(1) innovations\n(R²={r_f**2:.3f})")
axes[0].set_xlabel("Theoretical quantiles (Normal)")
axes[0].set_ylabel("Sample quantiles")
axes[0].grid(alpha=0.3)

(osm_s, osr_s), (slope_s, intercept_s, r_s) = stats.probplot(innov_s, dist="norm")
axes[1].scatter(osm_s, osr_s, s=18, color="#DD8452", alpha=0.8)
axes[1].plot(osm_s, slope_s*osm_s + intercept_s, color="black", lw=1, ls="--")
axes[1].set_title(f"Q-Q Plot — Severity AR(1) innovations\n(R²={r_s**2:.3f})")
axes[1].set_xlabel("Theoretical quantiles (Normal)")
axes[1].set_ylabel("Sample quantiles")
axes[1].grid(alpha=0.3)

plt.tight_layout()
plt.savefig(f"{OUT}/qq_innovations.png", dpi=150)

sw_f = stats.shapiro(innov_f)
sw_s = stats.shapiro(innov_s)
print("\nShapiro-Wilk normality test on AR(1) innovations (H0: Normal):")
print(f"  Frequency: W={sw_f.statistic:.3f}, p={sw_f.pvalue:.3f}"
      f"  -> {'no evidence against Normality' if sw_f.pvalue > 0.05 else 'REJECTS Normality at 5%'}")
print(f"  Severity:  W={sw_s.statistic:.3f}, p={sw_s.pvalue:.3f}"
      f"  -> {'no evidence against Normality' if sw_s.pvalue > 0.05 else 'REJECTS Normality at 5%'}")
print("Saved: qq_innovations.png")
print("NOTE: with only ~82 innovations this test has low power. Treat the Q-Q")
print("plot's shape (fat tails? one big outlier? skew?) as more informative")
print("than the p-value alone. A skewed severity residual is common when a")
print("level shift (e.g. the 2026 jump) leaks into the residual.")

# ---------------------------------------------------------------------------
# 3c. SIEVE BOOTSTRAP over trend/seasonal + AR(1) + covariance parameters
# ---------------------------------------------------------------------------
# Standard time-series ("sieve") bootstrap: fit an AR model, resample its
# (approximately i.i.d.) innovations with replacement, reconstruct a
# pseudo-residual path via the AR(1) recursion, add it back onto the ORIGINAL
# fitted trend+seasonal, then RE-FIT the whole model (trend, seasonal, AR(1),
# correlation) on that pseudo-series. Repeating this many times gives an
# empirical distribution over every parameter used downstream, capturing
# estimation ("parameter") uncertainty rather than only residual noise.
#
# Innovation PAIRS (freq, sev) are resampled jointly (same row index for both
# series) so the contemporaneous cross-correlation between them is preserved
# without having to assume a parametric copula for the resampling step itself.

N_BOOT = 500
n_obs = len(freq_resid)
innovations_paired = np.column_stack([innov_f, innov_s])   # shape (n_obs-1, 2)
n_innov = len(innovations_paired)

boot_freq_coef = np.zeros((N_BOOT, freq_coef.shape[0]))
boot_sev_coef = np.zeros((N_BOOT, sev_coef.shape[0]))
boot_freq_phi = np.zeros(N_BOOT)
boot_sev_phi = np.zeros(N_BOOT)
boot_L = np.zeros((N_BOOT, 2, 2))
n_fallback = 0

for b in range(N_BOOT):
    idx = rng.integers(0, n_innov, size=n_innov)
    boot_innov = innovations_paired[idx]

    # rebuild pseudo residual paths via the AR(1) recursion (fixed phi from
    # the original fit is used to PROPAGATE the resampled shocks; phi itself
    # gets re-estimated below once we have pseudo-data)
    boot_resid_f = np.empty(n_obs)
    boot_resid_s = np.empty(n_obs)
    boot_resid_f[0] = freq_resid[0]
    boot_resid_s[0] = sev_resid[0]
    for i in range(1, n_obs):
        boot_resid_f[i] = freq_phi * boot_resid_f[i-1] + boot_innov[i-1, 0]
        boot_resid_s[i] = sev_phi * boot_resid_s[i-1] + boot_innov[i-1, 1]

    # pseudo log-series = original fitted trend/seasonal + pseudo residual
    boot_log_freq = freq_fitted + boot_resid_f
    boot_log_sev = sev_fitted + boot_resid_s

    # re-fit trend + seasonal on the pseudo data
    c_f, fit_f, new_resid_f = fit_trend_seasonality(boot_log_freq, X_design)
    c_s, fit_s, new_resid_s = fit_trend_seasonality(boot_log_sev, X_design)
    boot_freq_coef[b] = c_f
    boot_sev_coef[b] = c_s

    # re-fit AR(1) + correlation on the new residuals
    phi_f_b, sigma_f_b, ni_f = ar1_fit(new_resid_f)
    phi_s_b, sigma_s_b, ni_s = ar1_fit(new_resid_s)
    boot_freq_phi[b] = phi_f_b
    boot_sev_phi[b] = phi_s_b

    rho_b = np.corrcoef(ni_f, ni_s)[0, 1]
    cov_b = np.array([[sigma_f_b**2, rho_b*sigma_f_b*sigma_s_b],
                       [rho_b*sigma_f_b*sigma_s_b, sigma_s_b**2]])
    try:
        boot_L[b] = np.linalg.cholesky(cov_b)
    except np.linalg.LinAlgError:
        boot_L[b] = L   # tiny-sample non-PD fallback
        n_fallback += 1

print(f"\nSieve bootstrap: {N_BOOT} resamples "
      f"({n_fallback} fell back to point-estimate covariance due to a "
      f"non-positive-definite draw).")
print("Bootstrap spread of annualized trend growth (90% interval):")
freq_trend_boot = np.exp(boot_freq_coef[:, 1]*12) - 1
sev_trend_boot = np.exp(boot_sev_coef[:, 1]*12) - 1
print(f"  Frequency: [{np.percentile(freq_trend_boot,5):+.2%}, {np.percentile(freq_trend_boot,95):+.2%}]"
      f"  (point estimate {np.exp(freq_coef[1]*12)-1:+.2%})")
print(f"  Severity:  [{np.percentile(sev_trend_boot,5):+.2%}, {np.percentile(sev_trend_boot,95):+.2%}]"
      f"  (point estimate {np.exp(sev_coef[1]*12)-1:+.2%})")

# ---------------------------------------------------------------------------
# 4. MONTE CARLO SIMULATION (parameter uncertainty + residual uncertainty)
# ---------------------------------------------------------------------------
N_SIMS = 10000
HORIZON = 60
future_dates = pd.date_range("2027-01-01", periods=HORIZON, freq="MS")
future_t = np.arange(len(df), len(df) + HORIZON)
future_month = future_dates.month.values

def trend_seasonal_log(coef, t_arr, month_arr):
    a, b = coef[0], coef[1]
    s = np.zeros(len(t_arr))
    for i, m in enumerate(month_arr):
        if m >= 2:
            s[i] = coef[m]
    return a + b * t_arr + s

last_freq_resid = freq_resid[-1]
last_sev_resid = sev_resid[-1]

# --- (A) ORIGINAL fixed-parameter simulation, kept as a baseline for comparison ---
sims_freq_fixed = np.zeros((N_SIMS, HORIZON))
sims_sev_fixed = np.zeros((N_SIMS, HORIZON))
freq_base_log = trend_seasonal_log(freq_coef, future_t, future_month)
sev_base_log = trend_seasonal_log(sev_coef, future_t, future_month)

for s in range(N_SIMS):
    rf, rs = last_freq_resid, last_sev_resid
    for h in range(HORIZON):
        z = L @ rng.normal(size=2)
        rf = freq_phi * rf + z[0]
        rs = sev_phi * rs + z[1]
        sims_freq_fixed[s, h] = np.exp(freq_base_log[h] + rf)
        sims_sev_fixed[s, h] = np.exp(sev_base_log[h] + rs)

# --- (B) BOOTSTRAP-AUGMENTED simulation: each path draws its own parameter set ---
sims_freq_boot = np.zeros((N_SIMS, HORIZON))
sims_sev_boot = np.zeros((N_SIMS, HORIZON))
boot_draw = rng.integers(0, N_BOOT, size=N_SIMS)

for s in range(N_SIMS):
    b_i = boot_draw[s]
    coef_f_s, coef_s_s = boot_freq_coef[b_i], boot_sev_coef[b_i]
    phi_f_s, phi_s_s = boot_freq_phi[b_i], boot_sev_phi[b_i]
    L_s = boot_L[b_i]

    freq_base_log_s = trend_seasonal_log(coef_f_s, future_t, future_month)
    sev_base_log_s = trend_seasonal_log(coef_s_s, future_t, future_month)

    rf, rs = last_freq_resid, last_sev_resid
    for h in range(HORIZON):
        z = L_s @ rng.normal(size=2)
        rf = phi_f_s * rf + z[0]
        rs = phi_s_s * rs + z[1]
        sims_freq_boot[s, h] = np.exp(freq_base_log_s[h] + rf)
        sims_sev_boot[s, h] = np.exp(sev_base_log_s[h] + rs)

# use the bootstrap-augmented sims as the "headline" simulation from here on
sims_freq, sims_sev = sims_freq_boot, sims_sev_boot

# ---------------------------------------------------------------------------
# 5. SUMMARIZE
# ---------------------------------------------------------------------------
pct = [5, 25, 50, 75, 95]
freq_pctiles = np.percentile(sims_freq, pct, axis=0)
sev_pctiles = np.percentile(sims_sev, pct, axis=0)
freq_pctiles_fixed = np.percentile(sims_freq_fixed, pct, axis=0)
sev_pctiles_fixed = np.percentile(sims_sev_fixed, pct, axis=0)

summary = pd.DataFrame({
    "date": future_dates,
    "freq_p5": freq_pctiles[0], "freq_p25": freq_pctiles[1], "freq_p50": freq_pctiles[2],
    "freq_p75": freq_pctiles[3], "freq_p95": freq_pctiles[4],
    "sev_p5": sev_pctiles[0], "sev_p25": sev_pctiles[1], "sev_p50": sev_pctiles[2],
    "sev_p75": sev_pctiles[3], "sev_p95": sev_pctiles[4],
})
summary.to_csv(f"{OUT}/simulation_summary_bootstrap.csv", index=False)
print("\nFirst 6 months of simulated forecast (median + 90% interval, WITH parameter bootstrap):")
print(summary.head(6).to_string(index=False))

# --- widen-ness comparison: how much extra spread does parameter uncertainty add? ---
h_check = [11, 35, 59]   # end of year 1, 3, 5
print("\nP5-P95 band width, fixed-parameter vs bootstrap-augmented (severity, $):")
for h in h_check:
    w_fixed = sev_pctiles_fixed[4, h] - sev_pctiles_fixed[0, h]
    w_boot = sev_pctiles[4, h] - sev_pctiles[0, h]
    print(f"  {future_dates[h].strftime('%b-%Y')}: fixed={w_fixed:8.0f}  "
          f"bootstrap={w_boot:8.0f}  (+{(w_boot/w_fixed - 1):.0%})")

# --- Annual roll-up ---
sims_freq_df = pd.DataFrame(sims_freq.T, index=future_dates)
sims_sev_df = pd.DataFrame(sims_sev.T, index=future_dates)
annual_freq_by_sim = sims_freq_df.groupby(sims_freq_df.index.year).mean()
annual_sev_by_sim = sims_sev_df.groupby(sims_sev_df.index.year).mean()

annual_summary = pd.DataFrame({
    "freq_p5": annual_freq_by_sim.quantile(0.05, axis=1),
    "freq_p25": annual_freq_by_sim.quantile(0.25, axis=1),
    "freq_p50": annual_freq_by_sim.quantile(0.50, axis=1),
    "freq_p75": annual_freq_by_sim.quantile(0.75, axis=1),
    "freq_p95": annual_freq_by_sim.quantile(0.95, axis=1),
    "sev_p5": annual_sev_by_sim.quantile(0.05, axis=1),
    "sev_p25": annual_sev_by_sim.quantile(0.25, axis=1),
    "sev_p50": annual_sev_by_sim.quantile(0.50, axis=1),
    "sev_p75": annual_sev_by_sim.quantile(0.75, axis=1),
    "sev_p95": annual_sev_by_sim.quantile(0.95, axis=1),
})
annual_summary.index.name = "year"
annual_summary.to_csv(f"{OUT}/annual_summary_bootstrap.csv")
print("\nAnnual average forecast (median + 90% interval) by year, WITH parameter bootstrap:")
print(annual_summary.round(4).to_string())

np.save(f"{OUT}/sims_freq_bootstrap.npy", sims_freq)
np.save(f"{OUT}/sims_sev_bootstrap.npy", sims_sev)

# ---------------------------------------------------------------------------
# 6. PLOT: fan chart comparison, fixed-parameter vs bootstrap-augmented
# ---------------------------------------------------------------------------
fig, axes = plt.subplots(2, 1, figsize=(11, 9), sharex=False)

ax = axes[0]
ax.plot(df.index, df["freq"]*100, color="black", lw=1.3, label="Historical")
ax.fill_between(future_dates, freq_pctiles_fixed[0]*100, freq_pctiles_fixed[4]*100,
                 color="gray", alpha=0.35, label="P5-P95 (fixed params, original method)")
ax.fill_between(future_dates, freq_pctiles[0]*100, freq_pctiles[4]*100,
                 color="#4C72B0", alpha=0.25, label="P5-P95 (+ parameter bootstrap)")
ax.plot(future_dates, freq_pctiles[2]*100, color="#4C72B0", lw=2, label="Median forecast (bootstrap)")
ax.set_title("Claims Frequency — Parameter Uncertainty Widens the Fan")
ax.set_ylabel("Frequency (%)")
ax.legend(loc="upper left", fontsize=8)
ax.grid(alpha=0.3)

ax = axes[1]
ax.plot(df.index, df["sev"], color="black", lw=1.3, label="Historical")
ax.fill_between(future_dates, sev_pctiles_fixed[0], sev_pctiles_fixed[4],
                 color="gray", alpha=0.35, label="P5-P95 (fixed params, original method)")
ax.fill_between(future_dates, sev_pctiles[0], sev_pctiles[4],
                 color="#DD8452", alpha=0.25, label="P5-P95 (+ parameter bootstrap)")
ax.plot(future_dates, sev_pctiles[2], color="#DD8452", lw=2, label="Median forecast (bootstrap)")
ax.set_title("Claims Severity — Parameter Uncertainty Widens the Fan")
ax.set_ylabel("Severity ($)")
ax.legend(loc="upper left", fontsize=8)
ax.grid(alpha=0.3)

for ax in axes:
    ax.xaxis.set_major_locator(mdates.YearLocator())
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y"))

plt.tight_layout()
plt.savefig(f"{OUT}/fan_chart_bootstrap_comparison.png", dpi=150)
print("\nSaved: fan_chart_bootstrap_comparison.png, qq_innovations.png,")
print("       simulation_summary_bootstrap.csv, annual_summary_bootstrap.csv,")
print("       sims_freq_bootstrap.npy, sims_sev_bootstrap.npy")

